# Copy to deploy/.env on the server and fill in.  (cp deploy/.env.example deploy/.env)

# Production bot token from @BotFather (use a different bot for local testing).
BOT_TOKEN=

# Domain pointing at this server (DNS A record). Caddy gets the HTTPS certificate for it.
DOMAIN=test.example.uz

# Database password. Letters and digits only (it's part of a URL), e.g. output of: openssl rand -hex 24
POSTGRES_PASSWORD=

EXAM_QUESTION_COUNT=25
