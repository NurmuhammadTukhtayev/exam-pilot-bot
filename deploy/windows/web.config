<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the deploy folder (C:\inetpub\exam-pilot-bot). deploy.ps1 copies it there.
  IIS forwards every request to the Mini App service on http://127.0.0.1:8000.
  Requires IIS "URL Rewrite 2.1" and "Application Request Routing 3.0" with the proxy enabled
  (see DEPLOY.md, Part 3).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- win-acme (Let's Encrypt) validation files are served by IIS itself -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Mini App" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Let the app's own JSON error responses (401/403/409) through instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />
    <!-- The app's code and secrets live in this folder: never let IIS serve them directly,
         even if URL Rewrite were missing or misconfigured. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".venv" />
          <add segment="bot" />
          <add segment="webapp" />
          <add segment="migrations" />
          <add segment="deploy" />
          <add segment="docs" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="backups" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
