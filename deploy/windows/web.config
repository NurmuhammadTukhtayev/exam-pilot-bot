<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the Mini App.
  Copy this file into the IIS site's physical folder (e.g. C:\inetpub\testbot).
  Requires IIS "URL Rewrite 2.1" and "Application Request Routing 3.0" with the proxy enabled
  (see DEPLOY.md, Windows Server). The Mini App service listens on http://127.0.0.1:8000.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- win-acme (Let's Encrypt) validation files are served by IIS from this folder -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Mini App" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Let the app's own JSON error responses (401/403/409) through instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
