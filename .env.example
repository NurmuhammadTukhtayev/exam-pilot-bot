# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-me

# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/testbot

# Number of questions in exam mode
EXAM_QUESTION_COUNT=25

# ---- Mini App (webapp/) ----
# Public HTTPS URL where the Mini App is served (e.g. https://test.example.uz/).
# When set, the bot shows a "📱 Mini App" button and sets the chat menu button.
WEBAPP_URL=
# How long (seconds) a Mini App login signature stays valid.
INIT_DATA_MAX_AGE=86400
# DEVELOPMENT ONLY: lets a plain browser use the API as this Telegram user id (no Telegram needed).
# Never set this on a server.
WEBAPP_DEV_USER_ID=
