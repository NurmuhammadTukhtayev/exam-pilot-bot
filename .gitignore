# ---- secrets / local config (templates are committed: .env.example, deploy/.env.example)
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example

# ---- Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- virtual environments
.venv/
venv/
env/

# ---- tooling caches & reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---- local data: SQLite databases, database dumps, backups, logs
data/*
!data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
*.dump
*.backup
backups/
logs/
*.log

# ---- question banks: kept out of git (they contain the answers); copied to the server separately
docs/*.docx
docs/~$*
docs/.~lock.*

# ---- editors / IDEs (personal settings)
.vscode/
.idea/
*.swp
*~

# ---- OS clutter
.DS_Store
Thumbs.db
desktop.ini
